---
// 使うアイコンだけをインライン SVG で持つ (アイコンフォントは読み込まない)
interface Props {
  name: 'x' | 'github' | 'rss' | 'search' | 'link' | 'calendar' | 'tag';
  label?: string;
}

const { name, label } = Astro.props;

const paths: Record<Props['name'], string> = {
  x: '<path fill="currentColor" d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L2.9 2h6.4l4.4 5.9L18.9 2Zm-1.1 18.1h1.7L8.3 3.8H6.5l11.3 16.3Z"/>',
  github:
    '<path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z"/>',
  rss: '<path fill="currentColor" d="M4 4.5a15.5 15.5 0 0 1 15.5 15.5h-3A12.5 12.5 0 0 0 4 7.5v-3Zm0 6a9.5 9.5 0 0 1 9.5 9.5h-3A6.5 6.5 0 0 0 4 13.5v-3ZM6 16a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z"/>',
  search:
    '<path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" d="M10.5 18a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15Zm5.3-2.2L21 21"/>',
  link: '<path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M10 14a4.5 4.5 0 0 0 6.4 0l3.3-3.3a4.5 4.5 0 0 0-6.4-6.4l-1 1M14 10a4.5 4.5 0 0 0-6.4 0l-3.3 3.3a4.5 4.5 0 0 0 6.4 6.4l1-1"/>',
  calendar:
    '<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M4 6.5h16V20H4zM4 10.5h16M8.5 4v4M15.5 4v4"/>',
  tag: '<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M3.5 12.6V3.5h9.1l8 8-9.1 9.1-8-8Z"/><circle cx="8" cy="8" r="1.4" fill="currentColor"/>',
};
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={paths[name]}
/>
